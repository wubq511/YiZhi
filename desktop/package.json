{
  "name": "yizhi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "YiZhi macOS desktop — T01 single-unit delivery",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/course-service.test.cjs",
    "test:electron": "npm run build && node scripts/electron-tests.mjs",
    "test:smoke": "npm run build && playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
