    "blocks": [
      {
        "id": "RB-KU-055-core",
        "kind": "paragraph",
        "role": "core",
        "payload": {
          "text": "复用器（MUX，也称数据选择器）根据选择端的取值，把多路数据中的一路送到公共输出。2 选 1 有 1 位选择端；4 选 1 有 2 位选择端，S1 是高位、S0 是低位。"
        },
        "sourceRefs": [
          {
            "sourceId": "SRC-C05",
            "versionId": "VER-SRC-C05-ad2a56210ce2",
            "pdfPages": [
              4
            ],
            "visualStatus": "verified",
            "note": "2:1 MUX 功能、真值表和表达式"
          },
          {
            "sourceId": "SRC-C05",
            "versionId": "VER-SRC-C05-ad2a56210ce2",
            "pdfPages": [
              11
            ],
            "visualStatus": "verified",
            "note": "4:1 MUX 位序、功能表和表达式"
          }
        ]
      },
      {
        "id": "RB-KU-055-formula-2",
        "kind": "formula",
        "role": "core",
        "payload": {
          "latex": "Y=\\overline{S}I_0+SI_1",
          "caption": "2 选 1：S=0 输出 I0，S=1 输出 I1。"
        },
        "sourceRefs": [
          {
            "sourceId": "SRC-C05",
            "versionId": "VER-SRC-C05-ad2a56210ce2",
            "pdfPages": [
              4
            ],
            "visualStatus": "verified",
            "note": "2:1 MUX 功能、真值表和表达式"
          }
        ]
      },
      {
        "id": "RB-KU-055-formula-4",
        "kind": "formula",
        "role": "core",
        "payload": {
          "latex": "Y=\\overline{S_1}\\,\\overline{S_0}I_0+\\overline{S_1}S_0I_1+S_1\\overline{S_0}I_2+S_1S_0I_3",
          "caption": "4 选 1：选择码 00、01、10、11 依次选择 I0、I1、I2、I3；这不是卡诺图的格雷列顺序。"
        },
        "sourceRefs": [
          {
            "sourceId": "SRC-C05",
            "versionId": "VER-SRC-C05-ad2a56210ce2",
            "pdfPages": [
              11
            ],
            "visualStatus": "verified",
            "note": "4:1 MUX 位序、功能表和表达式"
          }
        ]
      },
      {
        "id": "RB-KU-055-diagram",
        "kind": "interactive",
        "role": "core",
        "payload": {
          "component": "mux",
          "config": {
            "selectBits": [
              "S1",
              "S0"
            ],
            "dataSignals": [
              "z",
              "¬z",
              "0",
              "1"
            ]
          },
          "inputs": {
            "S1": 0,
            "S0": 1,
            "z": 0
          },
          "bindings": {
            "formula": "RB-KU-055-formula-4",
