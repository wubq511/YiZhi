    "KU-014": {
      "id": "KU-014",
      "name": "格雷码性质与编码转换",
      "kind": "method",
      "outcome": "能说明格雷码相邻一位变化的性质，并完成二进制与格雷码的双向转换。",
      "internals": [
        {
          "kind": "formula",
          "text": "二进制→格雷码：G_i=B_i⊕B_{i+1}（最高位 G_msb=B_msb）"
        },
        {
          "kind": "formula",
          "text": "格雷码→二进制：B_i=G_i⊕B_{i+1}，其中 B_{i+1} 是已解码的高位（最高位 B_msb=G_msb）"
        },
        {
          "kind": "condition",
          "text": "格雷码是无权码，不能按位权解释数值或直接进行普通算术运算"
        },
        {
          "kind": "example",
          "text": "作业 04：M=1 时二进制→格雷码；M=0 时格雷码→二进制，利用已求出的高位继续解码"
        }
      ],
