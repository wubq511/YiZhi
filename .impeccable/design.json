  "components": [
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "顶栏与普通面板中的次要操作。",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">知识关系</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:35px;padding:7px 12px;border:1px solid #dfe1e8;border-radius:8px;background:#fff;color:#3f454d;font:.75rem/1.2 var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif);cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease}.ds-btn-secondary:hover{border-color:#d4d1f1;background:#f6f5ff;color:#514db5}.ds-btn-secondary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-btn-secondary:active{transform:translateY(1px)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Agent 发送等明确的当前主动作。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">发送</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:6px 13px;border:1px solid #dcd7fa;border-radius:7px;background:var(--focus, #eeedff);color:var(--purple, #6965db);font:600 .75rem/1.5 var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif);cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease}.ds-btn-primary:hover{border-color:#c9c2f3;background:#e7e4ff}.ds-btn-primary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "课程知识、笔记、对话与原文的统一搜索。",
      "html": "<label class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m14.5 14.5 5 5\"/></svg><input type=\"search\" placeholder=\"找知识、笔记、对话或原文\" aria-label=\"搜索课程\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;min-height:40px;padding:8px 10px;border:1px solid #e4e5eb;border-radius:9px;background:#f8f8fa;color:#838591}.ds-search>span{font-size:17px;transform:translateY(-1px)}.ds-search input{width:100%;min-width:0;border:0;background:transparent;color:var(--ink, #27343e);font:.8125rem/1.5 var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif);outline:none}.ds-search input::placeholder{color:var(--ui-placeholder, #687080)}.ds-search:focus-within{border-color:#bcb7ee;background:#fff;box-shadow:0 0 0 3px #6965db10}.ds-search input:focus-visible{outline:none}"
    },
    {
      "name": "Active Navigation Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "课程目录中的当前知识单元。",
      "html": "<button class=\"ds-nav-item\" type=\"button\" aria-current=\"true\">1. 位置记数法与权展开</button>",
      "css": ".ds-nav-item{position:relative;display:block;width:100%;padding:7px 8px 7px 17px;border:0;border-radius:6px;background:var(--focus, #eeedff);color:var(--purple, #6965db);font:550 .8125rem/1.6 var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif);text-align:left;cursor:pointer;transition:background-color 140ms ease,color 140ms ease}.ds-nav-item:before{content:\"\";position:absolute;left:6px;top:50%;width:3px;height:14px;border-radius:3px;background:var(--purple, #6965db);transform:translateY(-50%)}.ds-nav-item:hover{background:#f5f4fb;color:#514db5}.ds-nav-item:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}"
    },
    {
      "name": "Scope Chip",
      "kind": "chip",
      "refersTo": "chip-scope",
      "description": "课程规模等短元信息。",
      "html": "<span class=\"ds-scope-chip\">20 个主题 · 84 个单元</span>",
      "css": ".ds-scope-chip{display:inline-flex;align-items:center;padding:5px 10px;border:1px solid #e6e6ec;border-radius:16px;background:#fbfbfc;color:var(--ui-muted, #626b79);font:.75rem/1.4 var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif);letter-spacing:.02em;white-space:nowrap}"
    },
    {
      "name": "Reading Card",
      "kind": "card",
      "refersTo": "card-reading",
      "description": "世界坐标正文示例；静态 SVG 表示手绘轮廓，不代替运行时 Rough.js 与相机布局。",
      "html": "<article class=\"ds-reading-card\"><svg class=\"ds-reading-sketch\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M2 2.4 L98 2 L98.3 97.8 L2.2 98 Z\"/><path d=\"M2.4 2 L97.8 2.5 L98 98 L2 97.6 Z\"/></svg><div class=\"ds-reading-inner\"><h3>三种基本逻辑运算与真值表</h3><p>与、或、非是三种最基本的逻辑运算：任何复杂的逻辑函数都可以由它们组合表达。</p></div></article>",
      "css": ".ds-reading-card{position:relative;max-width:520px;padding:35px 38px 28px;background:#fff;color:var(--ink, #27343e);font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-reading-sketch{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.ds-reading-sketch path{fill:none;stroke:#aebecb;stroke-width:.45;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-linejoin:round}.ds-reading-sketch path+path{opacity:.45}.ds-reading-inner{position:relative}.ds-reading-card h3{margin:4px 0 18px;font:400 34px/1.5 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-reading-card p{margin:0;font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}"
    },
    {
      "name": "Condition Card",
      "kind": "card",
      "refersTo": "card-condition",
      "description": "当前正文的规则蓝色提示框；与手绘单元外框区分。",
      "html": "<aside class=\"ds-condition-card\"><span class=\"ds-condition-label\">关键条件</span><p>2 选 1 MUX 用 S 选择输入：S=0 时输出 I₀，S=1 时输出 I₁。</p></aside>",
      "css": ".ds-condition-card{max-width:460px;padding:13px 16px;border:1px solid #bfd1e3;border-radius:9px;background:#f1f6fb;color:var(--ink,#27343e);font:24px/1.85 var(--hand,ReviewExcalifont,PrototypeXiaolai,\"Kaiti SC\",\"PingFang SC\",sans-serif)}.ds-condition-label{display:block;margin-bottom:6px;color:var(--blue,#345d88);font:16px/1.4 var(--ui,\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif)}.ds-condition-card p{margin:0}"
    },
    {
      "name": "Personal Note",
      "kind": "card",
      "refersTo": "personal-note-disclosure",
      "description": "原位展开的个人提醒，暖黄语义与课程提醒分开。",
      "html": "<details class=\"ds-personal-note\" open><summary>给自己的提醒</summary><div class=\"ds-note-content\"><textarea aria-label=\"个人笔记\" placeholder=\"记下你容易混淆的地方……\"></textarea></div></details>",
      "css": ".ds-personal-note{max-width:480px;border-top:1px solid var(--personal-note-line, #bc9a5b);color:var(--personal-note, #79551f);font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-personal-note summary{padding:13px 4px;border-radius:6px;cursor:pointer}.ds-personal-note summary:hover{background:#f5f8fa}.ds-personal-note summary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-note-content{padding:5px 8px 14px;background:var(--personal-note-fill, #fff7e5)}.ds-note-content textarea{width:100%;min-height:95px;resize:vertical;background:transparent;border:0;color:var(--personal-note, #79551f);font:23px/1.65 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-note-content textarea:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}"
    },
    {
      "name": "Material Disclosure",
      "kind": "custom",
      "refersTo": "material-disclosure",
      "description": "在所属单元原位展开已经备齐的学习材料。",
      "html": "<details class=\"ds-material\"><summary>完整例题<span>例题</span></summary><div class=\"ds-material-content\">例题展开后直接显示完整讲解，图形、公式和步骤保持相邻。</div></details>",
      "css": ".ds-material{max-width:480px;border-top:1px solid #d5dde3;padding-top:5px;color:var(--blue, #345d88);font:23px/1.65 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-material summary{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:13px 4px;border-radius:6px;cursor:pointer;list-style:none}.ds-material summary::-webkit-details-marker{display:none}.ds-material summary:before{content:\"＋\";width:24px;font:22px var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif)}.ds-material[open] summary:before{content:\"−\"}.ds-material summary:hover{background:#f5f8fa}.ds-material summary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-material summary span{margin-left:auto;padding:3px 6px;border:1px solid #cdd9e2;border-radius:5px;color:var(--muted, #68717a);font:14px var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif)}.ds-material-content{color:var(--ink,#27343e);font-size:24px;line-height:1.9;padding:5px 8px 14px;animation:ds-material-in 180ms cubic-bezier(.2,.75,.25,1)}@keyframes ds-material-in{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.ds-material-content{animation:none}}"
    },
    {
      "name": "Editing Toolbar",
      "kind": "custom",
      "refersTo": "editing-toolbar",
      "description": "文字、公式与个人图形标注的浮动工具组。",
      "html": "<div class=\"ds-editing-toolbar\" role=\"toolbar\" aria-label=\"编辑与标注工具\"><button type=\"button\" aria-pressed=\"true\">编辑与标注</button><button type=\"button\">选取文字</button><button type=\"button\">直线</button><button type=\"button\">波浪线</button><button type=\"button\">荧光笔</button></div>",
      "css": ".ds-editing-toolbar{display:flex;flex-wrap:wrap;gap:6px;max-width:940px;padding:7px;border:1px solid #b8c9d8;border-radius:11px;background:#fffefa;box-shadow:0 5px 20px #27384a12,0 1px 3px #27384e08}.ds-editing-toolbar button{min-height:30px;padding:5px 9px;border:1px solid #bdccda;border-radius:7px;background:#fff;color:#345d88;font:13px/1.6 system-ui,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease}.ds-editing-toolbar button:hover{border-color:#9fb7ce;background:#edf4fc}.ds-editing-toolbar button[aria-pressed=true]{border-color:#aaa3df;background:#eeedff;color:#514db5}.ds-editing-toolbar button:focus-visible{outline:2px solid #6965db;outline-offset:3px}.ds-editing-toolbar button:active{transform:translateY(1px)}"
    }
  ],
  "narrative": {
    "northStar": "手帐推演",
    "overview": "在一张安静的白纸上组织清楚的推演。顶栏、目录、表单和侧栏是低干扰的操作外壳；知识正文、图示、关系和个人标注承载手绘个性。简约意味着操作克制、信息层级明确，同时备齐必要的讲解、条件与题解。\n\n屏幕坐标中的界面使用 PingFang、细边界、小圆角和淡紫交互状态；画板世界中的学习内容由 Excalifont 承担拉丁字符、Xiaolai 承担中文，配合稳定的 Rough.js 线条和浅底语义色。MathLive 使用本地 KaTeX 数学字形。共享的石墨文字与留白把操作区和阅读区连接起来。\n\n远景、单元全览和正文阅读改变信息密度，保持知识身份与阅读顺序。主题总览可按画板可用宽度重新分列；单元正文仍使用稳定的局部坐标。动效解释相机、面板、消息与展开反馈；边框种子保持稳定。",
    "keyCharacteristics": [
      "白色画布、浅色系统控件、端正排版。",
