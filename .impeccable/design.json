  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "外壳 primary 按钮。",
      "html": "<button class=\"ds-button-primary\">继续</button>",
      "css": ".ds-button-primary{font:500 14px \"PingFang SC\",system-ui,sans-serif;height:40px;padding:0 10px;border-radius:8px;cursor:pointer;transition:background-color .15s;background:#6255c5;color:#fff;border:1px solid transparent}.ds-button-primary:hover{background:#7e73d1}.ds-button-primary:focus-visible{outline:2px solid var(--color-ring,#7568cd);outline-offset:2px}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "外壳 outline 按钮。",
      "html": "<button class=\"ds-button-outline\">重试保存</button>",
      "css": ".ds-button-outline{font:500 14px \"PingFang SC\",system-ui,sans-serif;height:40px;padding:0 10px;border-radius:8px;cursor:pointer;transition:background-color .15s;background:#fff;color:#30303b;border:1px solid #e5e3ec}.ds-button-outline:hover{background:#f0eff5}.ds-button-outline:focus-visible{outline:2px solid var(--color-ring,#7568cd);outline-offset:2px}.ds-button-outline:active{transform:translateY(1px)}.ds-button-outline:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "外壳 ghost 按钮。",
      "html": "<button class=\"ds-button-ghost\">课程菜单</button>",
      "css": ".ds-button-ghost{font:500 14px \"PingFang SC\",system-ui,sans-serif;height:40px;padding:0 10px;border-radius:8px;cursor:pointer;transition:background-color .15s;background:transparent;color:#696575;border:1px solid transparent}.ds-button-ghost:hover{background:#f0eff5}.ds-button-ghost:focus-visible{outline:2px solid var(--color-ring,#7568cd);outline-offset:2px}.ds-button-ghost:active{transform:translateY(1px)}.ds-button-ghost:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input-search",
      "description": "已有课程内容搜索。",
      "html": "<input class=\"ds-search\" aria-label=\"查找已有内容\" placeholder=\"关键词、别名或公式符号\">",
      "css": ".ds-search{font:13px \"PingFang SC\",system-ui,sans-serif;color:#27343e;background:#f8f8fa;border:1px solid #e5e5eb;border-radius:9px;padding:10px;min-width:230px}.ds-search::placeholder{color:#687080}.ds-search:hover{border-color:#b7afc7}.ds-search:focus-visible{outline:2px solid #7568cd;outline-offset:2px}"
    },
    {
      "name": "Navigation Rail",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "当前面板的稳定入口。",
      "html": "<nav class=\"ds-rail\" aria-label=\"工作区导航\"><button aria-expanded=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14m-1-14C8.8 5.5 6 5 2 5v15c4 0 6.8.5 9 2h2c2.2-1.5 5-2 9-2V5c-4 0-6.8.5-9 2z\"/></svg><span>目录</span></button></nav>",
      "css": ".ds-rail{background:var(--shell-surface,#f5f4f8);width:64px;padding:12px 0;display:flex;justify-content:center}.ds-rail button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;width:50px;height:56px;border:0;border-radius:10px;background:var(--shell-selected,#eeebfa);color:var(--shell-accent,#6555be);font:500 11px \"PingFang SC\",system-ui,sans-serif;cursor:pointer}.ds-rail button:hover{background:#e7e1f5}.ds-rail button:focus-visible{outline:2px solid #7568cd;outline-offset:2px}"
    },
    {
      "name": "Canvas Toolbar",
      "kind": "custom",
      "refersTo": "canvas-toolbar",
      "description": "屏幕坐标中的阅读与画板工具。",
      "html": "<div class=\"ds-tools\" role=\"toolbar\" aria-label=\"画板工具\"><button aria-label=\"阅读工具\" aria-pressed=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14m-1-14C8.8 5.5 6 5 2 5v15c4 0 6.8.5 9 2h2c2.2-1.5 5-2 9-2V5c-4 0-6.8.5-9 2z\"/></svg></button><span></span><button aria-label=\"选择工具\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m4 3 7.1 17 2.3-6.6L20 11z\"/></svg></button></div>",
      "css": ".ds-tools{display:inline-flex;align-items:center;gap:4px;padding:5px;height:40px;background:#fff;border-radius:12px;box-shadow:var(--shell-shadow,0 4px 18px #2f234014)}.ds-tools button{display:grid;place-items:center;width:36px;height:38px;border:0;border-radius:8px;background:transparent;color:#676071;cursor:pointer}.ds-tools button[aria-pressed=true]{background:#eeebfa;color:#6555be}.ds-tools button:hover{background:#f1eef7}.ds-tools button:focus-visible{outline:2px solid #7568cd;outline-offset:2px}.ds-tools>span{height:22px;width:1px;background:#e6e3ec}"
    },
    {
      "name": "Reading Card",
      "kind": "card",
      "refersTo": "card-reading",
      "description": "世界坐标正文示例；静态 SVG 表示手绘轮廓，不代替运行时 Rough.js 与相机布局。",
      "html": "<article class=\"ds-reading-card\"><svg class=\"ds-reading-sketch\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M2 2.4 L98 2 L98.3 97.8 L2.2 98 Z\"/><path d=\"M2.4 2 L97.8 2.5 L98 98 L2 97.6 Z\"/></svg><div class=\"ds-reading-inner\"><h3>三种基本逻辑运算与真值表</h3><p>与、或、非是三种最基本的逻辑运算：任何复杂的逻辑函数都可以由它们组合表达。</p></div></article>",
      "css": ".ds-reading-card{position:relative;max-width:520px;padding:35px 38px 28px;background:#fff;color:var(--ink, #27343e);font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-reading-sketch{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.ds-reading-sketch path{fill:none;stroke:#aebecb;stroke-width:.45;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-linejoin:round}.ds-reading-sketch path+path{opacity:.45}.ds-reading-inner{position:relative}.ds-reading-card h3{margin:4px 0 18px;font:400 34px/1.5 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-reading-card p{margin:0;font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}"
    },
    {
      "name": "Personal Note",
      "kind": "card",
      "refersTo": "personal-note-disclosure",
      "description": "原位展开的个人提醒，暖黄语义与课程提醒分开。",
      "html": "<details class=\"ds-personal-note\" open><summary>给自己的提醒</summary><div class=\"ds-note-content\"><textarea aria-label=\"个人笔记\" placeholder=\"记下你容易混淆的地方……\"></textarea></div></details>",
      "css": ".ds-personal-note{max-width:480px;border-top:1px solid var(--personal-note-line, #bc9a5b);color:var(--personal-note, #79551f);font:24px/1.85 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-personal-note summary{padding:13px 4px;border-radius:6px;cursor:pointer}.ds-personal-note summary:hover{background:#f5f8fa}.ds-personal-note summary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-note-content{padding:5px 8px 14px;background:var(--personal-note-fill, #fff7e5)}.ds-note-content textarea{width:100%;min-height:95px;resize:vertical;background:transparent;border:0;color:var(--personal-note, #79551f);font:23px/1.65 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-note-content textarea:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}"
    },
    {
      "name": "Material Disclosure",
      "kind": "custom",
      "refersTo": "material-disclosure",
      "description": "在所属单元原位展开已经备齐的学习材料。",
      "html": "<details class=\"ds-material\"><summary>完整例题<span>例题</span></summary><div class=\"ds-material-content\">例题展开后直接显示完整讲解，图形、公式和步骤保持相邻。</div></details>",
      "css": ".ds-material{max-width:480px;border-top:1px solid #d5dde3;padding-top:5px;color:var(--blue, #345d88);font:23px/1.65 var(--hand, ReviewExcalifont, PrototypeXiaolai, \"Kaiti SC\", \"PingFang SC\", sans-serif)}.ds-material summary{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:13px 4px;border-radius:6px;cursor:pointer;list-style:none}.ds-material summary::-webkit-details-marker{display:none}.ds-material summary:before{content:\"＋\";width:24px;font:22px var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif)}.ds-material[open] summary:before{content:\"−\"}.ds-material summary:hover{background:#f5f8fa}.ds-material summary:focus-visible{outline:2px solid var(--purple, #6965db);outline-offset:3px}.ds-material summary span{margin-left:auto;padding:3px 6px;border:1px solid #cdd9e2;border-radius:5px;color:var(--muted, #68717a);font:14px var(--ui, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif)}.ds-material-content{color:var(--ink,#27343e);font-size:24px;line-height:1.9;padding:5px 8px 14px;animation:ds-material-in 180ms cubic-bezier(.2,.75,.25,1)}@keyframes ds-material-in{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.ds-material-content{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "有序工作台，手绘推演",
    "overview": "学生在白色画板上持续阅读、练习和修改。操作外壳以浅灰紫底、规则字形和精确间距提供稳定位置；学习内容保留端正手绘笔触、完整讲解与语义配色。现代感来自层级、密度、焦点和状态的一致性。\n\n屏幕界面不随画板缩放；目录、搜索、笔记、资料与学习对话按需让出空间。控件靠近所作用的内容，课程级操作归于课程菜单；选中内容后直接提问、修改或批注。用户的阅读位置、输入和真实保存结果决定反馈。",
    "keyCharacteristics": [
